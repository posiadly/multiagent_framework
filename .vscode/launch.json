{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug subagents",
      "program": "${workspaceFolder}/examples/console/dist/apps.js",
      "cwd": "${workspaceFolder}/examples/console",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - examples/console/tsconfig.json",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/examples/console/dist/**/*.js",
        "${workspaceFolder}/examples/internet-search-mcp/dist/**/*.js",
        "${workspaceFolder}/packages/multiagent/dist/**/*.js"
      ]
    }
  ]
}
