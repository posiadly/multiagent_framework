# Required: sap | openrouter | ollama
LLM_PROVIDER=

# SAP AI Core service key JSON (stringified) — required when LLM_PROVIDER=sap
AICORE_SERVICE_KEY=

# Optional: override the orchestration model name (default: gpt-4o)
AICORE_MODEL=gpt-4o

# OpenRouter — required when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama — required when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=

# internet-search MCP (football agent) — DuckDuckGo search + Jina Reader scrape
# Optional Bearer protecting the local MCP HTTP endpoint (also sent by the framework client)
MCP_API_KEY=
# Jina Reader API key (used by the MCP server when calling r.jina.ai)
JINA_API_KEY=
# Optional listen address for the in-process internet-search MCP
INTERNET_SEARCH_MCP_HOST=127.0.0.1
INTERNET_SEARCH_MCP_PORT=3921
# Optional override if the MCP already runs elsewhere (skip in-process start by not using apps.ts defaults)
# INTERNET_SEARCH_MCP_URL=http://127.0.0.1:3921/mcp
